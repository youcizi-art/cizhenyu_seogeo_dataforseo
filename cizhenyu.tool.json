{
  "protocolVersion": 1,
  "id": "dataforseo",
  "name": "DataForSEO",
  "category": "seo",
  "tier": "recommended",
  "description": "SEO / SERP / keyword data",
  "source": {
    "github": "https://github.com/youcizi-art/cizhenyu_seogeo_dataforseo",
    "defaultRef": "master"
  },
  "install": {
    "runtime": "python",
    "steps": [],
    "readyCheck": [
      "server.py"
    ]
  },
  "credentials": {
    "key": "dataforseo",
    "fields": [
      {
        "type": "input",
        "name": "API_login",
        "label": "Login",
        "required": true,
        "tip": "Login from DataForSEO API Access (usually your email)",
        "link": {
          "label": "DataForSEO console",
          "url": "https://app.dataforseo.com/"
        }
      },
      {
        "type": "password",
        "name": "API_password",
        "label": "Password",
        "required": true,
        "tip": "API password, not the website login password"
      }
    ],
    "sidecar": "dataforseo.json"
  },
  "env": [
    {
      "name": "CIZHENYU_AUTH_DIR",
      "from": "credentialsDir"
    },
    {
      "name": "SEOGEO_AUTH_DIR",
      "from": "credentialsDir"
    }
  ],
  "mcp": {
    "transport": "stdio",
    "command": "python",
    "args": [
      "server.py"
    ],
    "cwd": "."
  },
  "guides": {
    "setup": "guides/setup.md",
    "setupByLocale": {
      "zh-CN": "guides/setup.md",
      "zh": "guides/setup.md",
      "en": "guides/setup.en.md",
      "en-US": "guides/setup.en.md"
    }
  },
  "health": {
    "requireCredentials": true,
    "requireReadyFiles": [
      "server.py"
    ]
  },
  "actions": [],
  "defaultLocale": "en",
  "i18n": {
    "zh-CN": {
      "description": "SEO / SERP / 关键词数据",
      "fields": {
        "API_login": {
          "tip": "DataForSEO API Access 中的 Login（通常是邮箱）",
          "linkLabel": "DataForSEO 控制台"
        },
        "API_password": {
          "tip": "API 密码，不是网页登录密码"
        }
      }
    }
  }
}
